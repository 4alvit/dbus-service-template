        service = {{ class_name }}Service(config=config)
        result = service.set_alarm("invalid_alarm", True)
        assert result is False

    def test_callback_registration(self, config):
        """Test callback registration."""
        service = {{ class_name }}Service(config=config)
        callback = Mock()

        service.register_callback("/TestPath", callback)
        service.register_callback("*", callback)  # Wildcard

        assert "/TestPath" in service._callbacks
        assert "*" in service._callbacks


