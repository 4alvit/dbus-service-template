class TestMQTTBridge:
    """Test MQTT bridge."""

    def test_bridge_init(self, config, mock_mqtt):
        """Test bridge initialization."""
        service = {{ class_name }}Service(config=config)

        from {{ module_name }}.mqtt_bridge import MQTTBridge
        bridge = MQTTBridge(config.mqtt, service)

        assert bridge.config.broker == "{{ mqtt_broker_default }}"
        assert bridge.config.port == {{ mqtt_port_default }}

    def test_bridge_connect(self, config, mock_mqtt):
        """Test bridge connection."""
        service = {{ class_name }}Service(config=config)

        from {{ module_name }}.mqtt_bridge import MQTTBridge
        bridge = MQTTBridge(config.mqtt, service)
        bridge.connect()

        mock_mqtt.connect.assert_called_once()
        mock_mqtt.loop_start.assert_called_once()

    def test_bridge_publish(self, config, mock_mqtt):
        """Test publishing to MQTT."""
        service = {{ class_name }}Service(config=config)

        from {{ module_name }}.mqtt_bridge import MQTTBridge
        bridge = MQTTBridge(config.mqtt, service)
        bridge._connected = True
        bridge._client = mock_mqtt

        result = bridge.publish("test/topic", "test_value")

        assert result is True
        mock_mqtt.publish.assert_called()

    def test_bridge_publish_path(self, config, mock_mqtt):
        """Test publishing D-Bus path to MQTT."""
        service = {{ class_name }}Service(config=config)

        from {{ module_name }}.mqtt_bridge import MQTTBridge
        bridge = MQTTBridge(config.mqtt, service)
        bridge._connected = True
        bridge._client = mock_mqtt

        # Add a path mapping
        bridge.set_custom_mapping("test/voltage", "/Dc/0/Voltage")

        result = bridge.publish_path("/Dc/0/Voltage", 48.5)

        assert result is True
        mock_mqtt.publish.assert_called()


