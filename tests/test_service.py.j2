class TestConfig:
    """Test configuration loading."""

    def test_default_config(self):
        """Test default configuration values."""
        config = Config()

        assert config.mqtt.broker == "{{ mqtt_broker_default }}"
        assert config.mqtt.port == {{ mqtt_port_default }}
        assert config.mqtt.topic_prefix == "{{ topic_prefix }}"
        assert config.device.device_type == "{{ device_type }}"
        assert config.log_level == "INFO"

    def test_config_from_yaml(self, tmp_path):
        """Test loading config from YAML file."""
        yaml_content = """
mqtt:
  broker: "192.168.1.100"
  port: 1883
  topic_prefix: "test_device"
device:
  device_type: "battery"
  custom_name: "My Battery"
log_level: "DEBUG"
"""
        config_file = tmp_path / "test_config.yaml"
        config_file.write_text(yaml_content)

        config = load_config(config_file)

        assert config.mqtt.broker == "192.168.1.100"
        assert config.mqtt.topic_prefix == "test_device"
        assert config.log_level == "DEBUG"

    def test_config_env_override(self, monkeypatch):
        """Test environment variable override."""
        monkeypatch.setenv("MQTT_BROKER", "env.broker")
        monkeypatch.setenv("MQTT_PORT", "8883")
        monkeypatch.setenv("DEVICE_CUSTOM_NAME", "Env Device")

        config = Config()

        assert config.mqtt.broker == "env.broker"
        assert config.mqtt.port == 8883
        assert config.device.custom_name == "Env Device"

    def test_config_validation(self):
        """Test configuration validation."""
        with pytest.raises(ValueError):
            Config(log_level="INVALID")

        with pytest.raises(ValueError):
            MQTTConfig(port=70000)

        with pytest.raises(ValueError):
            MQTTConfig(qos=3)


class TestModels:
    """Test data models."""

    def test_battery_data(self):
        """Test BatteryData model."""
        data = BatteryData(
            voltage=48.5,
            current=10.2,
            soc=85.5,
            temperature=25.0,
            cell_voltages=[3.0, 3.1, 3.05, 3.15] * 4,
        )

        assert data.voltage == 48.5
        assert data.current == 10.2
        assert data.soc == 85.5
        assert len(data.cell_voltages) == 16

    def test_pv_inverter_data(self):
        """Test PVInverterData model."""
        data = PVInverterData(
            ac_power=2500.0,
            ac_voltage=230.5,
            ac_current=10.8,
            ac_frequency=50.0,
            energy_forward=15.5,
        )

        assert data.ac_power == 2500.0
        assert data.ac_frequency == 50.0

    def test_grid_meter_data(self):
        """Test GridMeterData model."""
        data = GridMeterData(
            power=1500.0,
            voltage=230.0,
            current=6.5,
            energy_forward=1000.0,
            energy_reverse=50.0,
            frequency=50.0,
        )

        assert data.power == 1500.0
        assert data.energy_forward == 1000.0

