    @pytest.mark.parametrize("credentials", [
        {"password": "synthetic-test"},
        {"client_cert": "synthetic.pem", "client_key": "synthetic.key"},
    ])
    def test_mutated_credentials_rejected_before_client_creation(self, mock_dbus_service, credentials):
        config = MQTTConfig()
        bridge = MQTTBridge(config, mock_dbus_service)
        for name, value in credentials.items():
            setattr(config, name, value)
        with patch("paho.mqtt.client.Client") as client:
            with pytest.raises(ValueError, match="require use_tls"):
                bridge._create_client()
            client.assert_not_called()

    def test_reconnect_ignores_payload_errors_and_caps_attempts(self, bridge):
        bridge._running = True
        bridge._errors = 10 ** 6
        with patch("threading.Thread") as thread, patch("time.sleep") as sleep:
            for _ in range(12):
                bridge._schedule_reconnect()
                thread.call_args.kwargs["target"]()
            delays = [call.args[0] for call in sleep.call_args_list]
            assert delays[0] == bridge.config.reconnect_delay
            assert max(delays) == 300
            bridge._on_connect(bridge._client, None, {}, 0)
            bridge._schedule_reconnect()
            thread.call_args.kwargs["target"]()
            assert sleep.call_args.args[0] == bridge.config.reconnect_delay

    @pytest.mark.parametrize("key_bits,accepted", [(2048, False), (3072, True)])
    def test_real_tls_handshake_enforces_certificate_strength(self, mock_dbus_service, tmp_path, key_bits, accepted):
        """Use ephemeral synthetic certificates and a loopback TLS peer, no MQTT traffic."""
        import concurrent.futures
        import shutil
        import socket
        import ssl
        import subprocess

        openssl = shutil.which("openssl")
        if not openssl:
            pytest.skip("OpenSSL CLI is required for synthetic certificate generation")
        key, cert = tmp_path / "test-key.pem", tmp_path / "test-cert.pem"
        subprocess.run([
            openssl, "req", "-x509", "-newkey", f"rsa:{key_bits}", "-nodes",
            "-keyout", str(key), "-out", str(cert), "-days", "1",
            "-subj", "/CN=localhost", "-addext", "subjectAltName=DNS:localhost",
        ], check=True, capture_output=True, timeout=30)
        server_context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
        server_context.minimum_version = ssl.TLSVersion.TLSv1_2
        server_context.load_cert_chain(cert, key)
        bridge = MQTTBridge(MQTTConfig(use_tls=True, ca_cert=str(cert)), mock_dbus_service)
        bridge._create_client()

        def serve(listener):
            raw, _ = listener.accept()
            with raw:
                raw.settimeout(5)
                try:
                    with server_context.wrap_socket(raw, server_side=True):
                        return True
                except ssl.SSLError:
                    return False

        with socket.socket() as listener, concurrent.futures.ThreadPoolExecutor(max_workers=1) as executor:
            listener.bind(("127.0.0.1", 0))
            listener.settimeout(5)
            listener.listen(1)
            future = executor.submit(serve, listener)
            with socket.create_connection(listener.getsockname(), timeout=5) as raw:
                if accepted:
                    with bridge._client._ssl_context.wrap_socket(raw, server_hostname="localhost"):
                        pass
                else:
                    with pytest.raises(ssl.SSLCertVerificationError, match="(?i)key too (weak|small)"):
                        bridge._client._ssl_context.wrap_socket(raw, server_hostname="localhost")
            assert future.result(timeout=5) is accepted

    def test_topic_mappings_battery(self, mock_dbus_service):
        """Test battery topic mappings."""
        config = MQTTConfig(topic_prefix="battery")
        with patch('paho.mqtt.client.Client'):
            bridge = MQTTBridge(config, mock_dbus_service)

        # Check battery-specific mappings
        assert "battery/voltage" in bridge._topic_to_path
        assert "battery/current" in bridge._topic_to_path
        assert "battery/soc" in bridge._topic_to_path
        assert bridge._topic_to_path["battery/voltage"] == "/Dc/0/Voltage"
        assert bridge._topic_to_path["battery/soc"] == "/Soc"

    def test_topic_mappings_pv_inverter(self, mock_dbus_service):
        """Test PV inverter topic mappings."""
        mock_dbus_service.device_type = "pv_inverter"
        config = MQTTConfig(topic_prefix="pv_inverter")
        with patch('paho.mqtt.client.Client'):
            bridge = MQTTBridge(config, mock_dbus_service)

        assert "pv_inverter/ac_power" in bridge._topic_to_path
        assert "pv_inverter/ac_voltage" in bridge._topic_to_path
        assert bridge._topic_to_path["pv_inverter/ac_power"] == "/Ac/Power"

    def test_custom_mapping(self, bridge):
        """Test custom topic mapping."""
        bridge.set_custom_mapping("custom/topic", "/Custom/Path")

        assert "custom/topic" in bridge._topic_to_path
        assert bridge._topic_to_path["custom/topic"] == "/Custom/Path"
        assert "/Custom/Path" in bridge._path_to_topic
        assert bridge._path_to_topic["/Custom/Path"] == "custom/topic"

    def test_publish(self, bridge):
        """Test publishing to MQTT."""
        result = bridge.publish("test/topic", "test_value")

        assert result is True
        bridge._client.publish.assert_called_once_with(
            "test/topic",
            "test_value",
            qos=1,
            retain=False,
        )

    def test_publish_json(self, bridge):
        """Test publishing JSON to MQTT."""
        result = bridge.publish("test/topic", {"key": "value", "num": 42})

        assert result is True
        # Check that JSON was published
        call_args = bridge._client.publish.call_args
        assert call_args is not None
        published_payload = call_args.args[1]
        assert "key" in published_payload

    def test_publish_not_connected(self, mqtt_config, mock_dbus_service):
        """Test publishing when not connected."""
        with patch('paho.mqtt.client.Client') as mock_client:
            bridge = MQTTBridge(mqtt_config, mock_dbus_service)
            bridge._client = mock_client.return_value
            bridge._connected = False

            result = bridge.publish("test/topic", "value")

            assert result is False
            mock_client.return_value.publish.assert_not_called()

