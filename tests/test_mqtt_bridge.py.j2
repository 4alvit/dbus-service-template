    def test_real_tls_context_requires_modern_verified_pfs(self, mock_dbus_service):
        import ssl

        bridge = MQTTBridge(MQTTConfig(use_tls=True), mock_dbus_service)
        bridge._create_client()
        context = bridge._client._ssl_context
        assert context.minimum_version == ssl.TLSVersion.TLSv1_2
        assert context.verify_mode == ssl.CERT_REQUIRED
        assert context.check_hostname
        assert context.security_level >= 3
        for cipher in context.get_ciphers():
            assert cipher["strength_bits"] >= 128
            if cipher["protocol"] != "TLSv1.3":
                assert cipher["kea"] in {"kx-ecdhe", "kx-dhe"}
                assert cipher["aead"]

