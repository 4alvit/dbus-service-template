"""Portable fixtures, including a strict Venus OS dependency contract double."""

import importlib.util
import sys
from pathlib import Path
from types import ModuleType, SimpleNamespace

import pytest


@pytest.fixture
def platform_runtime(monkeypatch):
    """Import the real-dependency branch without connecting to a system D-Bus.

    The double deliberately exposes only public methods provided by upstream
    velib_python.VeDbusService. Adding imaginary convenience methods here would
    conceal runtime failures on Venus OS.
    """
    def load(*, vedbus_available=True):
        events = []
        exports = []
        package = "{{ module_name }}"
        source = Path(__file__).resolve().parents[1] / "src" / package

        class StrictVeDbusService:
            def __init__(self, servicename, bus=None, register=None):
                assert bus is None, "A GLib MainLoop is not a D-Bus connection"
                self.exported_name = servicename
                self.values = {}
                self.register_count = 0
                self.cleanup_count = 0
                exports.append(self)
                if register is None or register:
                    self.register()

            def register(self):
                # Publish the bus name only after mandatory paths exist.
                assert "/DeviceInstance" in self.values
                assert "/ProductId" in self.values
                assert "/Mgmt/ProcessName" in self.values
                assert "/Mgmt/ProcessVersion" in self.values
                assert "/Mgmt/Connection" in self.values
                self.register_count += 1
                events.append("register")

            def add_path(
                self, path, value, description="", writeable=False,
                onchangecallback=None, gettextcallback=None,
            ):
                assert path not in self.values, "Existing paths use item assignment"
                self.values[path] = value

            def __contains__(self, path):
                return path in self.values

            def __getitem__(self, path):
                return self.values[path]

            def __setitem__(self, path, value):
                assert path in self.values
                self.values[path] = value

            def __del__(self):
                self.cleanup_snapshot = self.values.copy()
                self.values.clear()
                self.cleanup_count += 1
                events.append("cleanup")

        class MainLoop:
            def run(self):
                assert exports[-1].register_count == 1
                assert exports[-1].values["/Connected"] == 1
                events.append("loop.run")

            def quit(self):
                events.append("loop.quit")

        def dbus_main_loop(*, set_as_default=False):
            assert set_as_default
            events.append("dbus.mainloop")

        dbus = ModuleType("dbus")
        dbus.__path__ = []
        dbus_mainloop = ModuleType("dbus.mainloop")
        dbus_mainloop.__path__ = []
        glib = ModuleType("dbus.mainloop.glib")
        glib.DBusGMainLoop = dbus_main_loop
        gi = ModuleType("gi")
        gi.__path__ = []
        repository = ModuleType("gi.repository")
        repository.GLib = SimpleNamespace(MainLoop=MainLoop)
        vedbus = ModuleType("vedbus")
        vedbus.VeDbusService = StrictVeDbusService
        for name, module in {
            "dbus": dbus,
            "dbus.mainloop": dbus_mainloop,
            "dbus.mainloop.glib": glib,
            "gi": gi,
            "gi.repository": repository,
            "vedbus": vedbus if vedbus_available else None,
        }.items():
            monkeypatch.setitem(sys.modules, name, module)

        def import_source(filename, name):
            spec = importlib.util.spec_from_file_location(name, source / filename)
            module = importlib.util.module_from_spec(spec)
            monkeypatch.setitem(sys.modules, name, module)
            spec.loader.exec_module(module)
            return module

        service = import_source("service.py", f"{package}._platform_service")
        monkeypatch.setitem(sys.modules, f"{package}.service", service)
        cli = import_source("__main__.py", f"{package}._platform_main")
        return SimpleNamespace(
            service=service, cli=cli, exports=exports, events=events,
            base=StrictVeDbusService,
        )

    return load
