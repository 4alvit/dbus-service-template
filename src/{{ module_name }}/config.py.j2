#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Configuration models for {{ class_name }}

Pydantic-based configuration with YAML file support and environment variable overrides.
"""

from __future__ import annotations

import os
from pathlib import Path
from typing import Any, Dict, List, Optional, Type, Union

from pydantic import Field, field_validator
from pydantic_settings import BaseSettings, SettingsConfigDict


class DeviceConfig(BaseSettings):
    """Device identification and metadata."""

    model_config = SettingsConfigDict(env_prefix="DEVICE_")

    model: str = Field(default="{{ class_name }}", alias="model")
    product_id: int = Field(default=0x0001, alias="product_id")
    product_name: str = Field(default="{{ project_name }}", alias="product_name")
    firmware_version: str = Field(default="0.1.0", alias="firmware_version")
    hardware_version: str = Field(default="1.0", alias="hardware_version")
    serial_number: str = Field(default="SN00000001", alias="serial_number")
    custom_name: str = Field(default="", alias="custom_name")

    # Device identification
    manufacturer: str = "Victron Energy"
    device_type: str = "{{ device_type }}"


class MQTTConfig(BaseSettings):
    """MQTT broker configuration."""

    model_config = SettingsConfigDict(env_prefix="MQTT_")

    # Broker connection
    broker: str = "{{ mqtt_broker_default }}"
    port: int = {{ mqtt_port_default }}
    use_tls: bool = False
    ca_cert: Optional[str] = None
    client_cert: Optional[str] = None
    client_key: Optional[str] = None

    # Authentication
    username: Optional[str] = None
    password: Optional[str] = None

    # Client settings
    client_id: str = "{{ module_name }}"
    clean_session: bool = True
    keepalive: int = 60

    # QoS and reliability
    qos: int = 1
    reconnect_delay: int = 5
    max_reconnect_delay: int = 300

    # Topics
    topic_prefix: str = "{{ topic_prefix }}"

    # Home Assistant discovery
    ha_discovery: bool = {% if cookiecutter.include_ha_discovery %}True{% else %}False{% endif %}
    device_name: Optional[str] = None

    @field_validator("port")
    @classmethod
    def validate_port(cls, v: int) -> int:
        if not 1 <= v <= 65535:
            raise ValueError("Port must be between 1 and 65535")
        return v

    @field_validator("qos")
    @classmethod
    def validate_qos(cls, v: int) -> int:
        if v not in (0, 1, 2):
            raise ValueError("QoS must be 0, 1, or 2")
        return v


class BatteryConfig(BaseSettings):
    """Battery-specific configuration."""

    model_config = SettingsConfigDict(env_prefix="BATTERY_")

    # Capacity and limits
    capacity_ah: float = 100.0
    max_charge_current: float = 100.0
    max_discharge_current: float = 100.0
    charge_voltage: float = 54.4

    # Cell configuration
    cells_per_battery: int = 16
    cell_min_voltage: float = 2.5
    cell_max_voltage: float = 3.65

    # SOC settings
    initial_soc: float = 50.0
    soc_min: float = 0.0
    soc_max: float = 100.0
    soc_low_threshold: float = 10.0
    soc_critical_threshold: float = 5.0

    # Temperature limits
    temp_charge_min: float = 0.0
    temp_charge_max: float = 45.0
    temp_discharge_min: float = -20.0
    temp_discharge_max: float = 55.0

    # alarms
    alarm_low_soc: float = 10.0
    alarm_high_temp: float = 45.0
    alarm_low_temp: float = 0.0
    alarm_cell_imbalance: float = 0.1


class PVInverterConfig(BaseSettings):
    """PV Inverter specific configuration."""

    model_config = SettingsConfigDict(env_prefix="PV_")

    max_power: float = 5000.0
    rated_voltage: float = 230.0
    phases: int = 1  # 1 or 3
    max_current_per_phase: float = 25.0


class GridMeterConfig(BaseSettings):
    """Grid Meter specific configuration."""

    model_config = SettingsConfigDict(env_prefix="GRID_")

    rated_voltage: float = 230.0
    phases: int = 1  # 1 or 3
    max_current: float = 100.0
    energy_forward: float = 0.0
    energy_reverse: float = 0.0


class TankConfig(BaseSettings):
    """Tank specific configuration."""

    model_config = SettingsConfigDict(env_prefix="TANK_")

    capacity: float = 1000.0
    fluid_type: int = 0  # 0=Fuel, 1=Fresh water, 2=Waste water, 3=Live well, 4=Oil, 5=Black water
    level_min: float = 0.0
    level_max: float = 100.0


class TemperatureConfig(BaseSettings):
    """Temperature sensor configuration."""

    model_config = SettingsConfigDict(env_prefix="TEMP_")

    sensor_type: int = 0  # 0=Internal, 1=External, 2=Battery, 3=MCU, 4=Ambient
    temp_min: float = -40.0
    temp_max: float = 85.0


class Config(BaseSettings):
    """Main configuration class."""

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=False,
        extra="ignore",
    )

    # Main sections
    device: DeviceConfig = Field(default_factory=DeviceConfig)
    mqtt: MQTTConfig = Field(default_factory=MQTTConfig)

    # Device-specific configs
    battery: BatteryConfig = Field(default_factory=BatteryConfig)
    pv_inverter: PVInverterConfig = Field(default_factory=PVInverterConfig)
    grid_meter: GridMeterConfig = Field(default_factory=GridMeterConfig)
    tank: TankConfig = Field(default_factory=TankConfig)
    temperature: TemperatureConfig = Field(default_factory=TemperatureConfig)

    # General settings
    log_level: str = "INFO"
    poll_interval_ms: int = 1000

    # Paths
    config_dir: Path = Path("/etc/{{ module_name }}")
    data_dir: Path = Path("/var/lib/{{ module_name }}")
    log_dir: Path = Path("/var/log/{{ module_name }}")

    @field_validator("log_level")
    @classmethod
    def validate_log_level(cls, v: str) -> str:
        valid = ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"]
        if v.upper() not in valid:
            raise ValueError(f"Log level must be one of {valid}")
        return v.upper()

    @property
    def initial_soc(self) -> float:
        return self.battery.initial_soc

    @property
    def capacity_ah(self) -> float:
        return self.battery.capacity_ah

    @property
    def max_charge_current(self) -> float:
        return self.battery.max_charge_current

    @property
    def max_discharge_current(self) -> float:
        return self.battery.max_discharge_current

    @property
    def charge_voltage(self) -> float:
        return self.battery.charge_voltage

    @property
    def max_power(self) -> float:
        return self.pv_inverter.max_power


def load_config(config_path: Optional[Union[str, Path]] = None) -> Config:
    """
    Load configuration from YAML file with environment variable overrides.

    Args:
        config_path: Path to YAML config file. If None, searches default locations.

    Returns:
        Config instance with merged settings.
    """
    config_dict: Dict[str, Any] = {}

    # Search for config file if not provided
    if config_path is None:
        search_paths = [
            Path("/etc/{{ module_name }}/config.yaml"),
            Path("/data/etc/{{ module_name }}/config.yaml"),
            Path("config.yaml"),
            Path("config.yml"),
        ]
        for path in search_paths:
            if path.exists():
                config_path = path
                break

    # Load YAML if found
    if config_path:
        import yaml
        with open(config_path) as f:
            yaml_config = yaml.safe_load(f)
            if yaml_config:
                config_dict.update(yaml_config)

    # Load environment variables
    env_config = _load_env_config()
    config_dict = _merge_dicts(config_dict, env_config)

    return Config(**config_dict)


def _load_env_config() -> Dict[str, Any]:
    """Load configuration from environment variables."""
    config = {}

    # Map env vars to nested config structure
    mappings = {
        "DEVICE_": "device",
        "MQTT_": "mqtt",
        "BATTERY_": "battery",
        "PV_": "pv_inverter",
        "GRID_": "grid_meter",
        "TANK_": "tank",
        "TEMP_": "temperature",
    }

    for prefix, section in mappings.items():
        section_config = {}
        for key, value in os.environ.items():
            if key.startswith(prefix):
                field_name = key[len(prefix):].lower()
                section_config[field_name] = _parse_env_value(value)
        if section_config:
            config[section] = section_config

    return config


def _parse_env_value(value: str) -> Any:
    """Parse environment variable value to appropriate type."""
    # Boolean
    if value.lower() in ("true", "yes", "1", "on"):
        return True
    if value.lower() in ("false", "no", "0", "off"):
        return False

    # Number
    try:
        if "." in value:
            return float(value)
        return int(value)
    except ValueError:
        pass

    # List (comma-separated)
    if "," in value:
        return [v.strip() for v in value.split(",")]

    return value


def _merge_dicts(base: Dict, override: Dict) -> Dict:
    """Deep merge two dictionaries."""
    result = base.copy()
    for key, value in override.items():
        if key in result and isinstance(result[key], dict) and isinstance(value, dict):
            result[key] = _merge_dicts(result[key], value)
        else:
            result[key] = value
    return result


# Backwards compatibility
BatteryData = Dict[str, Any]
PVInverterData = Dict[str, Any]
GridMeterData = Dict[str, Any]
TankData = Dict[str, Any]
TemperatureData = Dict[str, Any]


def get_data_model(device_type: str) -> Type[Union[BatteryData, PVInverterData, GridMeterData, TankData, TemperatureData, Dict]]:
    """Get appropriate data model for device type."""
    models = {
        "battery": BatteryData,
        "pv_inverter": PVInverterData,
        "grid_meter": GridMeterData,
        "tank": TankData,
        "temperature": TemperatureData,
    }
    return models.get(device_type.lower(), Dict)