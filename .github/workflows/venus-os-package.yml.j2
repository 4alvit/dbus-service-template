name: Venus OS SetupHelper Package

on:
  workflow_dispatch:
  push:
    tags: ["v*"]

permissions:
  contents: read

jobs:
  package:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0
      - name: Validate native installer syntax
        run: bash -n setup packaging/venus-os/{{ project_slug }}/setup
      - name: Build source archive
        run: |
          mkdir -p dist
          tar -czf dist/{{ project_slug }}-setuphelper.tar.gz \
            setup src packaging config.example.yaml pyproject.toml README.md
      - uses: actions/upload-artifact@v4
        with:
          name: {{ project_slug }}-setuphelper
          path: dist/*-setuphelper.tar.gz
