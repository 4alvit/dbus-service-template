# Venus OS .ipk package build for {{ project_name }}
# Run inside Venus OS SDK container:
# docker run --rm -v ${PWD}:/src victron/venus-sdk:latest make -C /src/packaging/venus-os/{{ project_slug }}

PKG_NAME := {{ project_slug }}
PKG_VERSION := 0.1.0
PKG_RELEASE := 1
PKG_SOURCE := $(PKG_NAME)-$(PKG_VERSION).tar.gz
PKG_SOURCE_URL := https://github.com/{{ github_org }}/{{ project_slug }}/archive/refs/tags/v$(PKG_VERSION).tar.gz
PKG_HASH := $(shell sha256sum $(PKG_SOURCE) 2>/dev/null | cut -d' ' -f1)

PKG_MAINTAINER := {{ author_name }} <{{ author_email }}>
PKG_LICENSE := {{ license_type }}
PKG_LICENSE_FILES := LICENSE

PKG_BUILD_DIR := $(BUILD_DIR)/$(PKG_NAME)-$(PKG_VERSION)

# Python package dependencies (installed via opkg)
DEPENDS := +python3 +python3-paho-mqtt +python3-pyyaml +python3-pydantic +python3-click

include $(INCLUDE_DIR)/package.mk
include $(INCLUDE_DIR)/python3-package.mk

define Package/$(PKG_NAME)
  SECTION := utils
  CATEGORY := Victron
  TITLE := {{ project_name }}
  URL := https://github.com/{{ github_org }}/{{ project_slug }}
  DEPENDS := $(DEPENDS)
endef

define Package/$(PKG_NAME)/description
  {{ project_description }}

  D-Bus service for Venus OS providing {{ device_type }} functionality.
  Features:
  - D-Bus service registration with standard Victron paths
{% if cookiecutter.mqtt_enabled %}
  - MQTT bridge for telemetry and control
{% endif %}
{% if cookiecutter.include_dvcc %}
  - DVCC (Dynamic Voltage/Current Control) integration
{% endif %}
  - Systemd service for auto-start on boot
  - Persistent across Venus OS firmware updates
endef

define Build/Prepare
	$(call Build/Prepare/Default)
	# Copy source files
	$(CP) -r $(PKG_BUILD_DIR)/src/* $(PKG_BUILD_DIR)/
endef

define Build/Compile
	# Build Python wheel from source
	cd $(PKG_BUILD_DIR); python3 setup.py bdist_wheel
endef

define Package/$(PKG_NAME)/install
	$(INSTALL_DIR) $(1)/opt/{{ project_slug }}
	$(INSTALL_DIR) $(1)/etc/{{ project_slug }}
	$(INSTALL_DIR) $(1)/etc/systemd/system
	$(INSTALL_DIR) $(1)/usr/lib/python3/dist-packages

	# Install Python package
	$(CP) $(PKG_BUILD_DIR)/dist/*.whl $(1)/usr/lib/python3/dist-packages/

	# Install config
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/config.example.yaml $(1)/etc/{{ project_slug }}/config.yaml

	# Install systemd service
	$(INSTALL_DATA) $(PKG_BUILD_DIR)/systemd/{{ project_slug }}.service $(1)/etc/systemd/system/
endef

define Package/$(PKG_NAME)/postinst
#!/bin/sh
systemctl daemon-reload
systemctl enable {{ project_slug }}
systemctl start {{ project_slug }}
endef

define Package/$(PKG_NAME)/prerm
#!/bin/sh
systemctl stop {{ project_slug }}
systemctl disable {{ project_slug }}
endef

$(eval $(call Python3Package,$(PKG_NAME)))
$(eval $(call BuildPackage,$(PKG_NAME)))