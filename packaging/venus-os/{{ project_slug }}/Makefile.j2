# Historical OpenWrt-style IPK recipe was not a Venus OS/Yocto recipe.
# Use the native SetupHelper installer. A real IPK requires a tested BitBake
# recipe built against the matching Victron Venus OS release and machine.
.PHONY: all
all:
	@echo "Use bash setup install on Venus OS; no validated IPK build is provided." >&2
	@exit 1
