[Unit]
Description={{ project_name }}
Documentation=https://github.com/{{ github_org }}/{{ project_slug }}
After=network.target dbus.service
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/{{ project_slug }}
ExecStart=/usr/bin/python3 -m {{ module_name }}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Environment variables
Environment=PYTHONUNBUFFERED=1
Environment=MQTT_BROKER=127.0.0.1
Environment=MQTT_PORT=1883
Environment=LOG_LEVEL=INFO

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/{{ project_slug }} /var/log/{{ project_slug }} /etc/{{ project_slug }}

[Install]
WantedBy=multi-user.target